# Backend environment (copy to .env). Never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
DATABASE_URL=
GOOGLE_API_KEY=
GROK_API_KEY=
ANTHROPIC_API_KEY=

# Public URL of the web app (comma separated for several). Used for CORS and the post-login redirect.
FRONTEND_URL=http://localhost:8501

# Secret that signs session tokens and derives the token-encryption key. Set a long random value in production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Optional: dedicated Fernet key for encrypting stored Google tokens (overrides the derived key).
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Optional: enables /rag/ingest, /rag/stats, /rag/delete (send as X-Admin-Key). Leave empty to keep them off.
ADMIN_API_KEY=
